<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<settings>

    <!-- ============================================================================ -->
    <!-- Connection -->
    <!-- ============================================================================ -->
    <category label="32001">
        <!-- Read-only display, not an input field — typing a URL here doesn't
             reliably work (Kodi's on-screen-keyboard edit to a Settings text
             field doesn't always land in the saved value, confirmed live
             2026-08-27). "Edit Connection" below is the one real entry point:
             it prompts for the URL itself via a proven-reliable dialog,
             whenever there isn't already one saved. -->
        <setting id="chronicle_url" type="text" label="32002" enable="false" default=""/>
        <setting id="authorization" type="action" label="32061" action="RunScript(service.chronicle.scrobbler,action=auth)"/>
        <setting id="change_url" type="action" label="32112" action="RunScript(service.chronicle.scrobbler,action=change_url)"/>
        <setting id="test_connection" type="action" label="32012" action="RunScript(service.chronicle.scrobbler,action=test_connection)"/>
        <setting id="auth_status" type="text" label="32080" enable="false" default=""/>
        <!-- Set automatically by the QR/PIN flow above — not meant to be typed by hand -->
        <setting id="api_key" type="text" label="32003" visible="false"/>
        <!-- Cached by _refresh_auth_status()'s GET /api/v1/users/me — last-known display
             name for whoever this API key belongs to, used as a fallback for the menu
             heading/auth_status when a fresh lookup can't reach Chronicle. Not user-facing
             on its own (auth_status already shows the formatted "Connected as {name}" text). -->
        <setting id="connected_display_name" type="text" visible="false"/>
    </category>

    <!-- ============================================================================ -->
    <!-- Scrobbling -->
    <!-- ============================================================================ -->
    <category label="32004">
        <setting id="watched_threshold" type="slider" label="32006" default="80" range="50,5,100" option="int"/>
        <setting id="poll_interval" type="slider" label="32007" default="30" range="15,5,120" option="int"/>
        <setting id="scrobble_movies" type="bool" label="32009" default="true"/>
        <setting id="scrobble_tv" type="bool" label="32015" default="true"/>
        <setting id="scrobble_music" type="bool" label="32016" default="false"/>
        <setting id="show_notifications" type="bool" label="32086" default="true" help="32087"/>
        <setting id="reset_tv_progress" type="action" label="32010" action="RunScript(service.chronicle.scrobbler,action=reset_tv)"/>
        <setting id="reset_movie_progress" type="action" label="32011" action="RunScript(service.chronicle.scrobbler,action=reset_movie)"/>
    </category>

    <!-- ============================================================================ -->
    <!-- Sync (Chronicle -> Kodi) -->
    <!-- ============================================================================ -->
    <category label="32074">
        <setting id="sync_ratings" type="bool" label="32076" default="true"/>
        <setting id="sync_progress" type="bool" label="32121" default="true"/>
        <setting id="sync_art" type="bool" label="32077" default="true"/>
        <setting id="sync_playcount" type="bool" label="32078" default="true"/>
        <setting id="sync_watch_history_now" type="action" label="32070" action="RunScript(service.chronicle.scrobbler,action=sync_watch_history)"/>
        <setting id="sync_lists_now" type="action" label="32050" action="RunScript(service.chronicle.scrobbler,action=sync_lists)"/>
    </category>

</settings>
